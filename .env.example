# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Project Settings → Database → Connection string → Transaction pooler
# (use the pooled connection, required for serverless/Vercel)
DATABASE_URL=

# Note: the Google OAuth Client ID / Secret are NOT app env vars — paste them
# directly into the Supabase dashboard under Authentication → Providers →
# Google. The Next.js app never needs them.

# Used for absolute URLs (Open Graph images, canonical links). Set this to
# the production URL once deployed (e.g. https://taalib.vercel.app) —
# defaults to localhost in dev if unset.
NEXT_PUBLIC_SITE_URL=

# Any random string. Set the same value in Vercel's project env vars after
# deploying — Vercel Cron automatically sends it as the Authorization header
# on scheduled requests to /api/cron/keep-alive, which prevents anyone else
# from triggering that endpoint. Generate one with `openssl rand -hex 32`.
CRON_SECRET=

# Quran.com API (api.quran.com) — OAuth2 client credentials, used server-side
# only to fetch chapters/verses for the Quran reader feature.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=
